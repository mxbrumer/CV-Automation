# Copy to infra/.env (gitignored) and change every "change-me" value.
# docker compose reads infra/.env automatically for variable substitution.

# Host folder for all runtime data; must be outside OneDrive (D6).
# Forward slashes work for both PowerShell and docker compose.
DATA_ROOT=C:/dev/JobSearchData

# Postgres. One server, two databases: the app DB and LangFlow's own DB.
# Use URL-safe characters in the password (it is embedded in connection URLs).
POSTGRES_USER=jobsearch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobsearch
LANGFLOW_DB=langflow

# LangFlow login (LANGFLOW_AUTO_LOGIN=false).
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=change-me
# API key the backend uses to run flows; create it in the LangFlow UI (Settings > API Keys).
LANGFLOW_API_KEY=
# Flow id or endpoint name that POST /api/v1/workflow/run starts. Imported flows keep their
# endpoint name, so the analysis flow works without looking up an id (plan 08); plan 09 sets the other.
LANGFLOW_ANALYSIS_FLOW_ID=analyze_and_match
LANGFLOW_GENERATION_FLOW_ID=

# Shared key between frontend, LangFlow components and the backend (A1).
BACKEND_API_KEY=change-me

# Native Ollama on the Windows host (D2).
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Models (D1). Values and reasons: docs/model-evaluation.md. Every caller sends the
# same LLM_NUM_CTX and LLM_KEEP_ALIVE; a different num_ctx makes Ollama reload the model.
LLM_AGENT_MODEL=ajs-gemma
LLM_WRITER_MODEL=ajs-gemma
EMBED_MODEL=bge-m3
LLM_NUM_CTX=32768
LLM_KEEP_ALIVE=30m

# Phoenix OTLP HTTP endpoint as seen from inside the compose network.
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006

# IMAP intake (plan 07). Use an app password.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_SENDER_ALLOWLIST=

# Match score threshold 0-100 (D8).
MATCH_THRESHOLD=55
