server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;

  # Same contract as the Vite dev proxy: /api goes to the backend with the API key added.
  location /api/ {
    proxy_pass http://backend:8000;
    proxy_set_header X-API-Key ${BACKEND_API_KEY};
  }
  location = /health {
    proxy_pass http://backend:8000;
  }

  location / {
    try_files $uri /index.html;
  }
}
